# Copy to .env at the repo root and fill in. .env is git-ignored; never commit it.
# The config module (ratatoskr_demo/config.py) is the only code that reads it.
POCKET_API_KEY=pk_REPLACE_ME
TODOIST_API_TOKEN=REPLACE_ME
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME
# Amazon Bedrock API key, sent only as "Authorization: Bearer" to bedrock-mantle.
BEDROCK_API_KEY=
# Optional: only the bench's Jev column uses it. Leave empty to skip that column.
TYPESAFE_API_KEY=
# Optional: only --owner-service (the companion app's owner service, ruling 61) needs it. Any long random string;
# the app asks for it once.
OWNER_SERVICE_TOKEN=
# Optional overrides (tests use these to point at temp dirs / fixtures)
# RATATOSKR_CONFIG=config.toml
# RATATOSKR_ENV_FILE=.env
# RATATOSKR_STATE_DIR=ledger
# RATATOSKR_FIXTURES=/path/to/fixtures   # when set, the Pocket client reads files instead of the network
